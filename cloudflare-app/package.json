    "cf:dev": "wrangler dev",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "@cloudflare/puppeteer": "^1.1.0",
    "@vitejs/plugin-react": "^4.7.0",
    "lucide-react": "^0.574.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "vite": "^6.4.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260722.1",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "typescript": "^5.9.3",
    "wrangler": "^4.86.0"
  }
}
